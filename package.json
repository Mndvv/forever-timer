{
  "name": "forever-timer-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:backend": "bun --filter forever-timer-backend dev",
    "dev:frontend": "bun --filter frontend dev",
    "build": "bun --filter forever-timer-backend build && bun --filter frontend build",
    "build:backend": "bun --filter forever-timer-backend build",
    "build:frontend": "bun --filter frontend build",
    "start": "bun run scripts/start-prod.ts",
    "start:prod": "bun run scripts/start-prod.ts"
  }
}
